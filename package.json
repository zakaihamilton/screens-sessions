{
  "name": "screens-sessions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && biome check .",
    "lint:eslint": "eslint .",
    "lint:biome": "biome check .",
    "format": "biome check --write .",
    "test": "jest",
    "test:run": "jest --ci",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd app",
    "health:coverage": "c8 --all --reporter=text npm run test",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#.repnix\" \"#generated\"",
    "health:a11y": "playwright test tests/e2e/guardrails.spec.ts --project=chromium --grep=WCAG",
    "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then playwright test tests/e2e/guardrails.spec.ts --project=chromium; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
    "health:interactions": "jest --runInBand",
    "health:styles": "stylelint --formatter json \"**/*.{css,pcss,postcss}\""
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "dictionary-he": "^2.0.0",
    "hunspell-asm": "^4.0.2",
    "lucide-react": "^0.556.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.42",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "^5.0.14",
    "jsdom": "^26.1.0",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "repnix": "^1.1.0",
    "typescript": "^6.0.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
